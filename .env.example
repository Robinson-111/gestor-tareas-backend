# Copiar a .env y completar los valores.
# No versionar credenciales reales.

SECRET_KEY=genera-una-clave-con-python-c-import-secrets-print-secrets-token_urlsafe-64

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Orígenes permitidos para el frontend (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=False

# Throttling del login
LOGIN_THROTTLE_RATE=10/min
PASSWORD_RESET_THROTTLE_RATE=5/min

# URL base del frontend para construir el enlace de recuperación.
FRONTEND_URL=http://localhost:5173

# Vida útil del token de restablecimiento (segundos).
PASSWORD_RESET_TIMEOUT=3600

# Correo saliente. Si MAIL_HOST o MAIL_USERNAME están vacíos, los correos se
# imprimen en la consola del backend (útil en desarrollo).
# En producción usa un SMTP real y un remitente verificado.
DEFAULT_FROM_EMAIL=TaskFlow <no-reply@taskflow.local>
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=True
MAIL_TIMEOUT=10

# Producción (DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
